# DoughTally environment variables.
# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser.

# --- Supabase (required) ------------------------------------------------------
# Project URL, from Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe in the browser: Row-Level Security does the guarding.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key. Bypasses RLS. Server-only: used by the market-data
# cron job, the owner console, and the scripts/ test fixtures. Keep it secret.
SUPABASE_SECRET_KEY=

# --- AI providers -------------------------------------------------------------
# Which model reads invoices, menus and recipes: "claude" or "gemini".
# NOTE: the Gemini provider is still a stub that extracts nothing, and it is the
# default when this is unset. Set this to "claude" for working scans.
VISION_PROVIDER=claude
# Anthropic API key: invoice/menu/recipe reading, item names, onboarding
# reasoning and the alert narrative. If empty, the Anthropic SDK falls back to
# ANTHROPIC_API_KEY.
CLAUDE_API_KEY=
# Voyage AI key for ingredient-matching embeddings (voyage-3.5, 1024 dims).
VOYAGE_API_KEY=

# --- Market Watch (optional) --------------------------------------------------
# USDA AMS MyMarketNews API key (free) for daily wholesale egg/butter/wheat prices.
# Without it the USDA series are skipped; the FAO Food Price Index needs no key.
USDA_API_KEY=
# Shared secret for GET /api/cron/ingest-market-data. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". Use a long random string.
CRON_SECRET=

# --- Access control (optional) ------------------------------------------------
# Set to "closed" to allow only DOUGHTALLY_ALLOWED_EMAILS to sign up / log in.
# Unset = open to everyone.
DOUGHTALLY_ACCESS=
# Comma-separated emails allowed in while DOUGHTALLY_ACCESS=closed.
DOUGHTALLY_ALLOWED_EMAILS=
# Comma-separated emails that can open the owner console at /admin
# (sign-ups and activity across every account). Unset = nobody.
DOUGHTALLY_ADMIN_EMAILS=

# --- Debugging (optional) -----------------------------------------------------
# "1" logs the raw vision-model response on the server. Leave empty in production.
VISION_DEBUG_RAW=
